# ==============================================================================
# EUPEACE Proxy Identifier - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Set to False in production
DEBUG=False

# Cryptographic key used for sessions, cookies, and tokens.
# Generate a strong key, e.g. via: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-this-insecure-key-to-a-secure-random-value-in-production

# Primary public FQDN of the proxy instance
PROXY_DOMAIN=proxy.eupeace.eu

# Comma-separated list of valid hostnames
ALLOWED_HOSTS=proxy.eupeace.eu,localhost,127.0.0.1

# Comma-separated list of origins trusted for CSRF
CSRF_TRUSTED_ORIGINS=https://proxy.eupeace.eu

# Cookie domain (prefix with a dot to share across subdomains if necessary)
SESSION_COOKIE_DOMAIN=.proxy.eupeace.eu

# ------------------------------------------------------------------------------
# 2. Database & Connection Pooling (PostgreSQL + PgBouncer)
# ------------------------------------------------------------------------------
DB_USER=eupeace_user
DB_PASSWORD=your_secure_database_password
DB_NAME=eupeace_db

# Connection string for Django. In Docker Compose, this connects via PgBouncer:
DATABASE_URL=postgres://eupeace_user:your_secure_database_password@pgbouncer:6432/eupeace_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 4. SAML 2.0 Service Provider Configuration
# ------------------------------------------------------------------------------
# Public Entity ID of this SP (registered with federation)
SAML_ENTITY_ID=https://proxy.eupeace.eu/saml2/metadata/

# ------------------------------------------------------------------------------
# 5. Outgoing Mail / SMTP Settings (Guest Invitations)
# ------------------------------------------------------------------------------
# Set to 'django.core.mail.backends.console.EmailBackend' for local debugging
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@eupeace.eu
